+static void retropvp_update_relay_custom(HWND dialog)
+{
+   LRESULT selection = SendDlgItemMessageA(dialog,
+         IDC_RETROPVP_RELAY_REGION, CB_GETCURSEL, 0, 0);
+   EnableWindow(GetDlgItem(dialog, IDC_RETROPVP_RELAY_CUSTOM),
+         selection == 4);
+}
+
+static INT_PTR CALLBACK retropvp_relay_dialog_proc(HWND dialog,
+      UINT message, WPARAM wparam, LPARAM lparam)
+{
+   static const char *server_ids[] = {
+      "nyc", "madrid", "saopaulo", "singapore", "custom"
+   };
+   static const char *server_labels[] = {
+      "New York", "Western Europe (Madrid)",
+      "Southeast Brazil", "Southeast Asia", "Custom"
+   };
+
+   if (message == WM_INITDIALOG)
+   {
+      settings_t *settings = config_get_ptr();
+      unsigned i;
+      int selection = 4;
+      for (i = 0; i < sizeof(server_ids) / sizeof(server_ids[0]); i++)
+      {
+         SendDlgItemMessageA(dialog, IDC_RETROPVP_RELAY_REGION,
+               CB_ADDSTRING, 0, (LPARAM)server_labels[i]);
+         if (strcmp(settings->arrays.netplay_mitm_server, server_ids[i]) == 0)
+            selection = (int)i;
+      }
+      SendDlgItemMessageA(dialog, IDC_RETROPVP_RELAY_REGION,
+            CB_SETCURSEL, selection, 0);
+      SetDlgItemTextA(dialog, IDC_RETROPVP_RELAY_CUSTOM,
+            settings->paths.netplay_custom_mitm_server);
+      retropvp_update_relay_custom(dialog);
+      return TRUE;
+   }
+
+   if (message == WM_COMMAND)
+   {
+      if (LOWORD(wparam) == IDC_RETROPVP_RELAY_REGION
+            && HIWORD(wparam) == CBN_SELCHANGE)
+      {
+         retropvp_update_relay_custom(dialog);
+         return TRUE;
+      }
+      if (LOWORD(wparam) == IDOK)
+      {
+         settings_t *settings = config_get_ptr();
+         int selection = (int)SendDlgItemMessageA(dialog,
+               IDC_RETROPVP_RELAY_REGION, CB_GETCURSEL, 0, 0);
+         char custom[256];
+         char old_server[sizeof(settings->arrays.netplay_mitm_server)];
+         char old_custom[sizeof(settings->paths.netplay_custom_mitm_server)];
+         if (selection < 0 || selection >=
+               (int)(sizeof(server_ids) / sizeof(server_ids[0])))
+            return TRUE;
+         GetDlgItemTextA(dialog, IDC_RETROPVP_RELAY_CUSTOM,
+               custom, sizeof(custom));
+         if (selection == 4 && !custom[0])
+         {
+            MessageBoxA(dialog, "Enter a custom relay address.",
+                  "RetroPvP", MB_OK | MB_ICONINFORMATION);
+            return TRUE;
+         }
+         strlcpy(old_server, settings->arrays.netplay_mitm_server,
+               sizeof(old_server));
+         strlcpy(old_custom, settings->paths.netplay_custom_mitm_server,
+               sizeof(old_custom));
+         strlcpy(settings->arrays.netplay_mitm_server,
+               server_ids[selection],
+               sizeof(settings->arrays.netplay_mitm_server));
+         strlcpy(settings->paths.netplay_custom_mitm_server, custom,
+               sizeof(settings->paths.netplay_custom_mitm_server));
+         if (command_event(CMD_EVENT_MENU_SAVE_CURRENT_CONFIG, NULL))
+            EndDialog(dialog, IDOK);
+         else
+         {
+            strlcpy(settings->arrays.netplay_mitm_server, old_server,
+                  sizeof(settings->arrays.netplay_mitm_server));
+            strlcpy(settings->paths.netplay_custom_mitm_server, old_custom,
+                  sizeof(settings->paths.netplay_custom_mitm_server));
+            MessageBoxA(dialog, "Could not save relay setting.",
+                  "RetroPvP", MB_OK | MB_ICONERROR);
+         }
+         return TRUE;
+      }
+      if (LOWORD(wparam) == IDCANCEL)
+      {
+         EndDialog(dialog, IDCANCEL);
+         return TRUE;
+      }
+   }
+
+   if (message == WM_CLOSE)
+   {
+      EndDialog(dialog, IDCANCEL);
+      return TRUE;
+   }
+
+   return FALSE;
+}
