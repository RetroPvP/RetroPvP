+#define RETROPVP_BIND_COUNT 11
+#define RETROPVP_HOTKEY_COUNT 11
+
+typedef struct retropvp_key_dialog_state
+{
+   HWND dialog;
+   unsigned port;
+   bool hotkeys;
+   int active_control;
+   unsigned active_bind;
+   enum retro_key original[RARCH_BIND_LIST_END];
+} retropvp_key_dialog_state_t;
+
+static HHOOK retropvp_keyboard_hook;
+static retropvp_key_dialog_state_t *retropvp_active_key_dialog;
+
+static unsigned retropvp_bind_id_from_control(int control)
+{
+   switch (control)
+   {
+      case IDC_RETROPVP_BIND_UP:
+         return RETRO_DEVICE_ID_JOYPAD_UP;
+      case IDC_RETROPVP_BIND_DOWN:
+         return RETRO_DEVICE_ID_JOYPAD_DOWN;
+      case IDC_RETROPVP_BIND_LEFT:
+         return RETRO_DEVICE_ID_JOYPAD_LEFT;
+      case IDC_RETROPVP_BIND_RIGHT:
+         return RETRO_DEVICE_ID_JOYPAD_RIGHT;
+      case IDC_RETROPVP_BIND_A:
+         return RETRO_DEVICE_ID_JOYPAD_A;
+      case IDC_RETROPVP_BIND_B:
+         return RETRO_DEVICE_ID_JOYPAD_B;
+      case IDC_RETROPVP_BIND_START:
+         return RETRO_DEVICE_ID_JOYPAD_START;
+      case IDC_RETROPVP_BIND_SELECT:
+         return RETRO_DEVICE_ID_JOYPAD_SELECT;
+      case IDC_RETROPVP_BIND_L:
+         return RETRO_DEVICE_ID_JOYPAD_L;
+      case IDC_RETROPVP_BIND_R:
+         return RETRO_DEVICE_ID_JOYPAD_R;
+      case IDC_RETROPVP_BIND_X:
+         return RETRO_DEVICE_ID_JOYPAD_X;
+      case IDC_RETROPVP_HOTKEY_MENU:
+         return RARCH_MENU_TOGGLE;
+      case IDC_RETROPVP_HOTKEY_PAUSE:
+         return RARCH_PAUSE_TOGGLE;
+      case IDC_RETROPVP_HOTKEY_SAVE:
+         return RARCH_SAVE_STATE_KEY;
+      case IDC_RETROPVP_HOTKEY_LOAD:
+         return RARCH_LOAD_STATE_KEY;
+      case IDC_RETROPVP_HOTKEY_SLOT_PREV:
+         return RARCH_STATE_SLOT_MINUS;
+      case IDC_RETROPVP_HOTKEY_SLOT_NEXT:
+         return RARCH_STATE_SLOT_PLUS;
+      case IDC_RETROPVP_HOTKEY_SCREENSHOT:
+         return RARCH_SCREENSHOT;
+      case IDC_RETROPVP_HOTKEY_RESET:
+         return RARCH_RESET;
+      case IDC_RETROPVP_HOTKEY_MUTE:
+         return RARCH_MUTE;
+      case IDC_RETROPVP_HOTKEY_FULLSCREEN:
+         return RARCH_FULLSCREEN_TOGGLE_KEY;
+      case IDC_RETROPVP_HOTKEY_QUIT:
+         return RARCH_QUIT_KEY;
+      default:
+         break;
+   }
+
+   return RARCH_BIND_LIST_END;
+}
+
+static void retropvp_set_bind_label(HWND dialog, int control,
+      enum retro_key key)
+{
+   char label[64];
+
+   if (key == RETROK_UNKNOWN)
+      strlcpy(label, "None", sizeof(label));
+   else
+      input_keymaps_translate_rk_to_str(key, label, sizeof(label));
+
+   SetDlgItemTextA(dialog, control, label);
+}
+
+static void retropvp_stop_key_capture(void)
+{
+   if (retropvp_keyboard_hook)
+   {
+      UnhookWindowsHookEx(retropvp_keyboard_hook);
+      retropvp_keyboard_hook = NULL;
+   }
+   retropvp_active_key_dialog = NULL;
+}
+
+static LRESULT CALLBACK retropvp_keyboard_hook_proc(
+      int code, WPARAM wparam, LPARAM lparam)
+{
+   retropvp_key_dialog_state_t *state = retropvp_active_key_dialog;
+
+   if (code == HC_ACTION && state && state->active_control
+         && !(lparam & 0x80000000))
+   {
+      enum retro_key key = RETROK_UNKNOWN;
+      unsigned scan = (unsigned)((lparam >> 16) & 0xFF);
+
+      if (wparam == VK_DELETE)
+         key = RETROK_UNKNOWN;
+      else
+      {
+         if (lparam & 0x01000000)
+            scan |= 0xE000;
+         if (!scan)
+            scan = MapVirtualKeyA((UINT)wparam, MAPVK_VK_TO_VSC);
+         key = input_keymaps_translate_keysym_to_rk(scan);
+      }
+
+      if (key != RETROK_UNKNOWN || wparam == VK_DELETE)
+      {
+         HWND dialog = state->dialog;
+         input_config_binds[state->port][state->active_bind].key = key;
+         retropvp_set_bind_label(dialog, state->active_control, key);
+         state->active_control = 0;
+         retropvp_stop_key_capture();
+         return 1;
+      }
+
+      return 1;
+   }
+
+   return CallNextHookEx(retropvp_keyboard_hook, code, wparam, lparam);
+}
+
+static INT_PTR CALLBACK retropvp_key_dialog_proc(HWND dialog,
+      UINT message, WPARAM wparam, LPARAM lparam)
+{
+   retropvp_key_dialog_state_t *state = (retropvp_key_dialog_state_t*)
+      GetWindowLongPtrA(dialog, DWLP_USER);
+
+   if (message == WM_INITDIALOG)
+   {
+      unsigned i;
+      static const int game_controls[RETROPVP_BIND_COUNT] = {
+         IDC_RETROPVP_BIND_UP,
+         IDC_RETROPVP_BIND_DOWN,
+         IDC_RETROPVP_BIND_LEFT,
+         IDC_RETROPVP_BIND_RIGHT,
+         IDC_RETROPVP_BIND_A,
+         IDC_RETROPVP_BIND_B,
+         IDC_RETROPVP_BIND_START,
+         IDC_RETROPVP_BIND_SELECT,
+         IDC_RETROPVP_BIND_L,
+         IDC_RETROPVP_BIND_R,
+         IDC_RETROPVP_BIND_X
+      };
+      static const int hotkey_controls[RETROPVP_HOTKEY_COUNT] = {
+         IDC_RETROPVP_HOTKEY_MENU,
+         IDC_RETROPVP_HOTKEY_PAUSE,
+         IDC_RETROPVP_HOTKEY_SAVE,
+         IDC_RETROPVP_HOTKEY_LOAD,
+         IDC_RETROPVP_HOTKEY_SLOT_PREV,
+         IDC_RETROPVP_HOTKEY_SLOT_NEXT,
+         IDC_RETROPVP_HOTKEY_SCREENSHOT,
+         IDC_RETROPVP_HOTKEY_RESET,
+         IDC_RETROPVP_HOTKEY_MUTE,
+         IDC_RETROPVP_HOTKEY_FULLSCREEN,
+         IDC_RETROPVP_HOTKEY_QUIT
+      };
+      const int *controls;
+      unsigned control_count;
+
+      state = (retropvp_key_dialog_state_t*)lparam;
+      state->dialog = dialog;
+      SetWindowLongPtrA(dialog, DWLP_USER, (LONG_PTR)state);
+      controls = state->hotkeys ? hotkey_controls : game_controls;
+      control_count = state->hotkeys
+         ? RETROPVP_HOTKEY_COUNT : RETROPVP_BIND_COUNT;
+      for (i = 0; i < RARCH_BIND_LIST_END; i++)
+         state->original[i] = input_config_binds[state->port][i].key;
+
+      for (i = 0; i < control_count; i++)
+      {
+         unsigned bind_id = retropvp_bind_id_from_control(controls[i]);
+         if (bind_id < RARCH_BIND_LIST_END
+               && GetDlgItem(dialog, controls[i]))
+            retropvp_set_bind_label(dialog, controls[i],
+                  input_config_binds[state->port][bind_id].key);
+      }
+
+      return TRUE;
+   }
+
+   if (!state)
+      return FALSE;
+
+   switch (message)
+   {
+      case WM_COMMAND:
+         {
+            unsigned bind_id = retropvp_bind_id_from_control(LOWORD(wparam));
+            if (HIWORD(wparam) == BN_CLICKED
+                  && bind_id < RARCH_BIND_LIST_END)
+            {
+               if (state->active_control)
+                  retropvp_set_bind_label(dialog, state->active_control,
+                        input_config_binds[state->port][state->active_bind].key);
+               retropvp_stop_key_capture();
+               state->active_control = LOWORD(wparam);
+               state->active_bind    = bind_id;
+               retropvp_active_key_dialog = state;
+               retropvp_keyboard_hook = SetWindowsHookExA(
+                     WH_KEYBOARD, retropvp_keyboard_hook_proc, NULL,
+                     GetCurrentThreadId());
+               if (retropvp_keyboard_hook)
+                  SetDlgItemTextA(dialog, state->active_control, "Press key...");
+               else
+               {
+                  state->active_control = 0;
+                  MessageBoxA(dialog, "Could not capture keyboard input.",
+                        "RetroPvP", MB_OK | MB_ICONERROR);
+               }
+               return TRUE;
+            }
+
+            if (LOWORD(wparam) == IDOK)
+            {
+               retropvp_stop_key_capture();
+               state->active_control = 0;
+               if (command_event(CMD_EVENT_MENU_SAVE_CURRENT_CONFIG, NULL))
+                  EndDialog(dialog, IDOK);
+               else
+                  MessageBoxA(dialog, "Could not save key bindings.",
+                        "RetroPvP", MB_OK | MB_ICONERROR);
+               return TRUE;
+            }
+
+            if (LOWORD(wparam) == IDCANCEL)
+            {
+               unsigned i;
+               retropvp_stop_key_capture();
+               for (i = 0; i < RARCH_BIND_LIST_END; i++)
+                  input_config_binds[state->port][i].key = state->original[i];
+               EndDialog(dialog, IDCANCEL);
+               return TRUE;
+            }
+         }
+         break;
+      case WM_CLOSE:
+         {
+            unsigned i;
+            retropvp_stop_key_capture();
+            for (i = 0; i < RARCH_BIND_LIST_END; i++)
+               input_config_binds[state->port][i].key = state->original[i];
+            EndDialog(dialog, IDCANCEL);
+         }
+         return TRUE;
+      default:
+         break;
+   }
+
+   return FALSE;
+}
+
+typedef struct retropvp_volume_dialog_state
+{
+   float original_volume;
+   int current_volume;
+} retropvp_volume_dialog_state_t;
+
+static void retropvp_apply_volume(HWND dialog, int volume)
+{
+   settings_t *settings = config_get_ptr();
+   char label[32];
+
+   if (volume < -80)
+      volume = -80;
+   if (volume > 12)
+      volume = 12;
+
+   settings->floats.audio_volume = (float)volume;
+   audio_set_float(AUDIO_ACTION_VOLUME_GAIN, (float)volume);
+   snprintf(label, sizeof(label), "%d dB", volume);
+   SetDlgItemTextA(dialog, IDC_RETROPVP_VOLUME_VALUE, label);
+   SetScrollPos(GetDlgItem(dialog, IDC_RETROPVP_VOLUME_SLIDER),
+         SB_CTL, volume, TRUE);
+}
+
+static INT_PTR CALLBACK retropvp_volume_dialog_proc(HWND dialog,
+      UINT message, WPARAM wparam, LPARAM lparam)
+{
+   retropvp_volume_dialog_state_t *state = (retropvp_volume_dialog_state_t*)
+      GetWindowLongPtrA(dialog, DWLP_USER);
+
+   if (message == WM_INITDIALOG)
+   {
+      settings_t *settings = config_get_ptr();
+      SCROLLINFO info;
+      int volume = (int)settings->floats.audio_volume;
+      state = (retropvp_volume_dialog_state_t*)lparam;
+      state->original_volume = settings->floats.audio_volume;
+      if (settings->floats.audio_volume < 0.0f
+            && settings->floats.audio_volume != (float)volume)
+         volume--;
+      state->current_volume = volume;
+      SetWindowLongPtrA(dialog, DWLP_USER, (LONG_PTR)state);
+      memset(&info, 0, sizeof(info));
+      info.cbSize = sizeof(info);
+      info.fMask = SIF_RANGE | SIF_POS;
+      info.nMin = -80;
+      info.nMax = 12;
+      info.nPos = volume;
+      SetScrollInfo(GetDlgItem(dialog, IDC_RETROPVP_VOLUME_SLIDER),
+            SB_CTL, &info, TRUE);
+      retropvp_apply_volume(dialog, volume);
+      return TRUE;
+   }
+
+   if (!state)
+      return FALSE;
+
+   if (message == WM_HSCROLL)
+   {
+      int volume = state->current_volume;
+      SCROLLINFO info;
+      memset(&info, 0, sizeof(info));
+      info.cbSize = sizeof(info);
+      info.fMask = SIF_TRACKPOS;
+      switch (LOWORD(wparam))
+      {
+         case SB_LINELEFT:   volume--; break;
+         case SB_LINERIGHT:  volume++; break;
+         case SB_PAGELEFT:   volume -= 6; break;
+         case SB_PAGERIGHT:  volume += 6; break;
+         case SB_TOP:        volume = -80; break;
+         case SB_BOTTOM:     volume = 12; break;
+         case SB_THUMBPOSITION:
+         case SB_THUMBTRACK:
+            GetScrollInfo((HWND)lparam, SB_CTL, &info);
+            volume = info.nTrackPos;
+            break;
+         default:
+            return TRUE;
+      }
+      state->current_volume = volume;
+      retropvp_apply_volume(dialog, volume);
+      return TRUE;
+   }
+
+   if (message == WM_COMMAND)
+   {
+      if (LOWORD(wparam) == IDOK)
+      {
+         if (command_event(CMD_EVENT_MENU_SAVE_CURRENT_CONFIG, NULL))
+            EndDialog(dialog, IDOK);
+         else
+            MessageBoxA(dialog, "Could not save volume setting.",
+                  "RetroPvP", MB_OK | MB_ICONERROR);
+         return TRUE;
+      }
+      if (LOWORD(wparam) == IDCANCEL)
+      {
+         settings_t *settings = config_get_ptr();
+         settings->floats.audio_volume = state->original_volume;
+         audio_set_float(AUDIO_ACTION_VOLUME_GAIN, state->original_volume);
+         EndDialog(dialog, IDCANCEL);
+         return TRUE;
+      }
+   }
+
+   if (message == WM_CLOSE)
+   {
+      settings_t *settings = config_get_ptr();
+      settings->floats.audio_volume = state->original_volume;
+      audio_set_float(AUDIO_ACTION_VOLUME_GAIN, state->original_volume);
+      EndDialog(dialog, IDCANCEL);
+      return TRUE;
+   }
+
+   return FALSE;
+}
