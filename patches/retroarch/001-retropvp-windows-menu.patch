+static bool retropvp_connect_to_host(void)
+{
+   bool success = false;
+
+   if (netplay_driver_ctl(RARCH_NETPLAY_CTL_USE_CORE_PACKET_INTERFACE, NULL))
+   {
+      netplay_driver_ctl(RARCH_NETPLAY_CTL_ENABLE_CLIENT, NULL);
+      success = command_event(CMD_EVENT_NETPLAY_INIT_DIRECT,
+            (void*)retropvp_netplay_address);
+   }
+   else if (task_push_netplay_content_reload(retropvp_netplay_address))
+      success = true;
+   else
+   {
+#ifdef HAVE_DYNAMIC
+      command_event(CMD_EVENT_NETPLAY_DEINIT, NULL);
+      netplay_driver_ctl(RARCH_NETPLAY_CTL_ENABLE_CLIENT, NULL);
+      success = command_event(CMD_EVENT_NETPLAY_INIT_DIRECT_DEFERRED,
+            (void*)retropvp_netplay_address);
+#endif
+   }
+
+   if (!success)
+      RARCH_ERR("[RetroPvP] Could not start a connection to the host.\n");
+   return success;
+}
+
+static bool retropvp_write_host_mode_config(bool use_relay)
+{
+   const char *append_path = path_get(RARCH_PATH_CONFIG_APPEND);
+   config_file_t *config;
+   bool saved;
+
+   /* The RetroPvP launcher supplies one project-local append config. */
+   if (string_is_empty(append_path))
+      return false;
+
+   config = config_file_new(append_path);
+   if (!config)
+      return false;
+
+   config_set_string(config, "netplay_use_mitm_server",
+         use_relay ? "true" : "false");
+   config_set_string(config, "netplay_nat_traversal",
+         use_relay ? "false" : "true");
+   saved = config_file_write(config, append_path, true);
+   config_file_free(config);
+   return saved;
+}
+
+static bool retropvp_start_host(HWND owner, bool use_relay)
+{
+   settings_t *settings = config_get_ptr();
+
+   if (netplay_driver_ctl(RARCH_NETPLAY_CTL_IS_ENABLED, NULL))
+   {
+      MessageBoxA(owner, "Disconnect from the current session first.",
+            "RetroPvP", MB_OK | MB_ICONINFORMATION);
+      return false;
+   }
+
+   if (!retropvp_write_host_mode_config(use_relay))
+   {
+      MessageBoxA(owner,
+            "Could not save the host mode for the SMB1 reload.",
+            "RetroPvP", MB_OK | MB_ICONERROR);
+      return false;
+   }
+
+   settings->bools.netplay_use_mitm_server = use_relay;
+   settings->bools.netplay_nat_traversal  = !use_relay;
+
+   if (!command_event(CMD_EVENT_NETPLAY_ENABLE_HOST, NULL))
+   {
+      MessageBoxA(owner, use_relay ? "Could not start relay hosting." :
+            "Could not start direct hosting.", "RetroPvP",
+            MB_OK | MB_ICONERROR);
+      return false;
+   }
+
+   return true;
+}
+
+static bool retropvp_copy_host_address(HWND owner)
+{
+   net_driver_state_t *net_st;
+   struct nat_traversal_data *nat;
+   char host[256];
+   char port[6];
+   char endpoint[512];
+   char message[600];
+   HGLOBAL clipboard_data;
+   char *clipboard_text;
+   size_t text_size;
+
+   if (!netplay_driver_ctl(RARCH_NETPLAY_CTL_IS_ENABLED, NULL)
+         || !netplay_driver_ctl(RARCH_NETPLAY_CTL_IS_SERVER, NULL))
+   {
+      MessageBoxA(owner, "Start hosting first.", "RetroPvP",
+            MB_OK | MB_ICONINFORMATION);
+      return false;
+   }
+
+   net_st = networking_state_get_ptr();
+   if (!string_is_empty(net_st->host_room.mitm_session)
+         && !string_is_empty(net_st->host_room.mitm_address)
+         && net_st->host_room.mitm_port > 0)
+      snprintf(endpoint, sizeof(endpoint), "%s|%d|%s",
+            net_st->host_room.mitm_address, net_st->host_room.mitm_port,
+            net_st->host_room.mitm_session);
+   else
+   {
+      nat = &net_st->nat_traversal_request;
+      if (nat->status != NAT_TRAVERSAL_STATUS_OPENED
+            || nat->request.addr.sin_family != AF_INET
+            || !nat->request.addr.sin_port)
+      {
+         MessageBoxA(owner,
+               "No public host address or relay invite is available yet.",
+               "RetroPvP", MB_OK | MB_ICONINFORMATION);
+         return false;
+      }
+
+      if (ipv4_is_cgnat_address(&nat->request.addr)
+            || ipv4_is_lan_address(&nat->request.addr))
+      {
+         MessageBoxA(owner,
+               "The mapped address is not reachable from the internet.",
+               "RetroPvP", MB_OK | MB_ICONINFORMATION);
+         return false;
+      }
+
+      if (getnameinfo_retro((struct sockaddr*)&nat->request.addr,
+               sizeof(nat->request.addr), host, sizeof(host), port,
+               sizeof(port), NI_NUMERICHOST | NI_NUMERICSERV))
+      {
+         MessageBoxA(owner, "Could not read the host address.", "RetroPvP",
+               MB_OK | MB_ICONERROR);
+         return false;
+      }
+
+      snprintf(endpoint, sizeof(endpoint), "%s|%s", host, port);
+   }
+   text_size = strlen(endpoint) + 1;
+   clipboard_data = GlobalAlloc(GMEM_MOVEABLE, text_size);
+   if (!clipboard_data)
+   {
+      MessageBoxA(owner, "Could not copy the host address.", "RetroPvP",
+            MB_OK | MB_ICONERROR);
+      return false;
+   }
+
+   clipboard_text = (char*)GlobalLock(clipboard_data);
+   if (!clipboard_text)
+   {
+      GlobalFree(clipboard_data);
+      MessageBoxA(owner, "Could not copy the host address.", "RetroPvP",
+            MB_OK | MB_ICONERROR);
+      return false;
+   }
+   memcpy(clipboard_text, endpoint, text_size);
+   GlobalUnlock(clipboard_data);
+
+   if (!OpenClipboard(owner))
+   {
+      GlobalFree(clipboard_data);
+      MessageBoxA(owner, "Could not access the clipboard.", "RetroPvP",
+            MB_OK | MB_ICONERROR);
+      return false;
+   }
+   if (!EmptyClipboard() || !SetClipboardData(CF_TEXT, clipboard_data))
+   {
+      CloseClipboard();
+      GlobalFree(clipboard_data);
+      MessageBoxA(owner, "Could not copy the host address.", "RetroPvP",
+            MB_OK | MB_ICONERROR);
+      return false;
+   }
+   CloseClipboard();
+
+   snprintf(message, sizeof(message), "Copied join address:\r\n%s", endpoint);
+   MessageBoxA(owner, message, "RetroPvP", MB_OK | MB_ICONINFORMATION);
+   return true;
+}
+#endif
