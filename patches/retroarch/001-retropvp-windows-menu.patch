+static INT_PTR CALLBACK retropvp_connect_dialog_proc(HWND dialog,
+      UINT message, WPARAM wparam, LPARAM lparam)
+{
+   if (message == WM_INITDIALOG)
+   {
+      retropvp_netplay_address[0] = '\0';
+      SetFocus(GetDlgItem(dialog, IDC_RETROPVP_ADDRESS));
+      return FALSE;
+   }
+
+   if (message == WM_COMMAND)
+   {
+      if (LOWORD(wparam) == IDOK)
+      {
+         GetDlgItemTextA(dialog, IDC_RETROPVP_ADDRESS,
+               retropvp_netplay_address,
+               sizeof(retropvp_netplay_address));
+         if (retropvp_netplay_address[0])
+            EndDialog(dialog, IDOK);
+         else
+            MessageBoxA(dialog, "Enter a host address.", "RetroPvP",
+                  MB_OK | MB_ICONINFORMATION);
+         return TRUE;
+      }
+      if (LOWORD(wparam) == IDCANCEL)
+      {
+         EndDialog(dialog, IDCANCEL);
+         return TRUE;
+      }
+   }
+
+   return FALSE;
+}
